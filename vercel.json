{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/d/:cod",
      "destination": "/demo/index.html"
    },
    {
      "source": "/adm",
      "destination": "/index.html"
    },
    {
      "source": "/adm/",
      "destination": "/index.html"
    },
    {
      "source": "/prospectar",
      "destination": "/prospectar.html"
    },
    {
      "source": "/prospectar/",
      "destination": "/prospectar.html"
    },
    {
      "source": "/agendar/:slug",
      "destination": "/agendar.html"
    },
    {
      "source": "/exame/:slug",
      "destination": "/agendar.html"
    },
    {
      "source": "/exame",
      "destination": "/agendar.html"
    },
    {
      "source": "/agendar",
      "destination": "/agendar.html"
    }
  ]
}
